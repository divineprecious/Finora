<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Finora.Pages.Modals.AddExpense"
             WidthRequest="800"
             HeightRequest="600"
             Title="AddExpense">
    <VerticalStackLayout>
        <Label HorizontalOptions="Center" Text="Add a new expense"/>

        <Entry HorizontalOptions="Center"
            Margin="0,20,0,0"
            x:Name="expAmount"
            Placeholder="Amount"
            />

        <Entry HorizontalOptions="Center"
            Margin="0,20,0,0"
            x:Name="expCategory"
            Placeholder="Category"
            />

        <DatePicker 
            HorizontalOptions="Center"
            x:Name="expDate"
            Margin="0,20,0,0"
            />

        <Button
            Margin="0,30,0,20"
            Text="Add"
            WidthRequest="300"
            BackgroundColor="#285430"
            FontFamily="Montserrat"
            Clicked="OnAddClicked"
           />
    </VerticalStackLayout>
</ContentPage>