<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Finora.Pages.Modals.AddTransaction"
             Title="Transaction"
             WidthRequest="800"
             HeightRequest="600"
             >
    <VerticalStackLayout>
        <Label HorizontalOptions="Center" Text="Add a new transaction"/>

        <Entry HorizontalOptions="Center"
            Margin="0,20,0,0"
            x:Name="transAmount"
            Placeholder="Amount"
            />

        <Picker Margin="0,20,0,0" HorizontalOptions="Center" x:Name="transType">
            <Picker.ItemsSource>
                <x:Array Type="{x:Type x:String}">
                    <x:String>Income</x:String>
                    <x:String>Expense</x:String>
                </x:Array>
            </Picker.ItemsSource>
        </Picker>

        <Entry HorizontalOptions="Center"
            Margin="0,20,0,0"
            x:Name="transCategory"
            Placeholder="Category"
            />

        <DatePicker 
            HorizontalOptions="Center"
            x:Name="transDate"
            Margin="0,20,0,0"
            />

        <Button
            Margin="0,30,0,20"
            Text="Add"
            WidthRequest="300"
            BackgroundColor="#285430"
            FontFamily="Montserrat"
            Clicked="OnAddClicked"
           />
    </VerticalStackLayout>
</ContentPage>